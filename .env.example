# 复制为 .env.local（vercel dev 会自动读取；.env* 已被 .gitignore 排除，切勿提交真实密钥）

# ---- Supabase ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# 没有 service_role 时可用匿名密钥（需自行放行 RLS 策略）
# SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_TABLE=name_history

# ---- 4 家模型（用哪个填哪个，没填的在页面上会标「未配置密钥」）----
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-2-1-pro-260915

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_MODEL=qwen-plus

MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3.1-pro
